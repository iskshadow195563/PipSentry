<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ Text ============ -->
  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text0}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>
  <Style x:Key="H2" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text0}" />
  </Style>
  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource Text1}" />
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
  </Style>
  <Style x:Key="SectionLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text3}" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <!-- ============ Icon button ============ -->
  <Style x:Key="IconBtn" TargetType="Button">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="9" SnapsToDevicePixels="True">
            <Path x:Name="glyph" Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}"
                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource Bg3}" />
              <Setter TargetName="glyph" Property="Stroke" Value="{DynamicResource Text0}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource Bg4}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="IconBtnSm" TargetType="Button" BasedOn="{StaticResource IconBtn}">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="7">
            <Path x:Name="glyph" Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}"
                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverSoft}" />
              <Setter TargetName="glyph" Property="Stroke" Value="{DynamicResource Text0}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource PressedSoft}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Ghost text button ============ -->
  <Style x:Key="GhostBtn" TargetType="Button">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text1}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Stroke}"
                  BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource Bg3}" />
              <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource StrokeStrong}" />
              <Setter Property="Foreground" Value="{DynamicResource Text0}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Primary button ============ -->
  <Style x:Key="PrimaryBtn" TargetType="Button">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="Foreground" Value="#FF04121B" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="glow" CornerRadius="12" Background="{DynamicResource AccentGradient}" Opacity="0"
                    Margin="-2" />
            <Border x:Name="bg" CornerRadius="10" Background="{DynamicResource AccentGradient}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentGradientHover}" />
              <Setter TargetName="glow" Property="Opacity" Value="0.28" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bg" Property="Opacity" Value="0.86" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.3" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Search box ============ -->
  <Style x:Key="SearchBox" TargetType="TextBox">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="30,0,10,0" />
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="Foreground" Value="{DynamicResource Text0}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoft}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Stroke}"
                  BorderThickness="1" CornerRadius="9">
            <Grid>
              <Path Data="{StaticResource IcoSearch}" Stroke="{DynamicResource Text3}" StrokeThickness="1.4"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" Stretch="Uniform" />
              <TextBlock x:Name="ph" Text="搜尋視窗…" Foreground="{DynamicResource Text3}"
                         FontFamily="{StaticResource UiFont}" FontSize="12.5"
                         VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False" />
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="ph" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Text" Value="{x:Null}">
              <Setter TargetName="ph" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Text" Value="" />
                <Condition Property="IsKeyboardFocused" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="ph" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource StrokeStrong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}" />
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource Bg3}" />
              <Setter TargetName="ph" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Switch ============ -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Border x:Name="track" CornerRadius="11" Background="{DynamicResource Bg3}"
                    BorderBrush="{DynamicResource StrokeStrong}" BorderThickness="1" />
            <Border x:Name="thumb" Width="14" Height="14" CornerRadius="7" Background="{DynamicResource SwitchThumbOff}"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ThicknessAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="Margin"
                                        To="20,0,0,0" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ThicknessAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="Margin"
                                        To="4,0,0,0" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
              <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentGradient}" />
              <Setter TargetName="track" Property="BorderBrush" Value="Transparent" />
              <Setter TargetName="thumb" Property="Background" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Segmented radio ============ -->
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bg" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverSoft}" />
              <Setter Property="Foreground" Value="{DynamicResource Text0}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource Bg4}" />
              <Setter Property="Foreground" Value="{DynamicResource Text0}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SegmentGroup" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Bg1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="3" />
  </Style>

  <!-- ============ Scrollbar ============ -->
  <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{DynamicResource ScrollThumb}" CornerRadius="4" Margin="1,2" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FlatScrollViewer" TargetType="ScrollViewer">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="False" />
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource ThinScrollBar}"
                       Orientation="Vertical" Value="{TemplateBinding VerticalOffset}"
                       Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Window list item ============ -->
  <Style x:Key="WindowItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="bg" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <Border x:Name="bar" Width="2.5" Height="18" CornerRadius="2" Background="{DynamicResource Accent}"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" Margin="1,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource Bg2}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource Bg3}" />
              <Setter TargetName="bar" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Tile (setting card) ============ -->
  <Style x:Key="Tile" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Bg1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="13,11" />
    <Setter Property="Margin" Value="4" />
  </Style>

  <!-- ============ Tooltip ============ -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Bg4}" />
    <Setter Property="Foreground" Value="{DynamicResource Text0}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"
                  BorderBrush="{DynamicResource StrokeStrong}" BorderThickness="1">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Context menu ============ -->
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="Foreground" Value="{DynamicResource Text1}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="5"
                  BorderBrush="{DynamicResource StrokeStrong}" BorderThickness="1">
            <StackPanel IsItemsHost="True" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text1}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <Grid>
              <ContentPresenter ContentSource="Header" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource Bg4}" />
              <Setter Property="Foreground" Value="{DynamicResource Text0}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="6,5" />
    <Setter Property="Background" Value="{DynamicResource Stroke}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Background="{TemplateBinding Background}" Height="1" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>