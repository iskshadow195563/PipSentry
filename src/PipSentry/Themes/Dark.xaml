<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- PipSentry dark palette -->
  <SolidColorBrush x:Key="Bg0" Color="#FF070A0E" />
  <SolidColorBrush x:Key="Bg1" Color="#FF0B1017" />
  <SolidColorBrush x:Key="Bg2" Color="#FF111923" />
  <SolidColorBrush x:Key="Bg3" Color="#FF17222F" />
  <SolidColorBrush x:Key="Bg4" Color="#FF1E2B3A" />

  <SolidColorBrush x:Key="Stroke" Color="#FF1B2735" />
  <SolidColorBrush x:Key="StrokeSoft" Color="#FF16202B" />
  <SolidColorBrush x:Key="StrokeStrong" Color="#FF2B3D52" />

  <SolidColorBrush x:Key="Text0" Color="#FFF1F6FC" />
  <SolidColorBrush x:Key="Text1" Color="#FFC3D2E3" />
  <SolidColorBrush x:Key="Text2" Color="#FF8A9CB2" />
  <SolidColorBrush x:Key="Text3" Color="#FF5F7086" />

  <SolidColorBrush x:Key="Accent" Color="#FF3FD2F5" />
  <SolidColorBrush x:Key="Accent2" Color="#FF4C7DFF" />
  <SolidColorBrush x:Key="AccentSoft" Color="#263FD2F5" />
  <SolidColorBrush x:Key="AccentGlow" Color="#403FD2F5" />

  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF3FD2F5" Offset="0" />
    <GradientStop Color="#FF4C7DFF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF62E0FB" Offset="0" />
    <GradientStop Color="#FF6B93FF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HeaderGlow" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#2A3FD2F5" Offset="0" />
    <GradientStop Color="#00000000" Offset="0.65" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF0D141C" Offset="0" />
    <GradientStop Color="#FF0A0F16" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Success" Color="#FF35D49B" />
  <SolidColorBrush x:Key="Warn" Color="#FFFFB13D" />
  <SolidColorBrush x:Key="Danger" Color="#FFFF5D6C" />
  <SolidColorBrush x:Key="Live" Color="#FFFF4D5E" />

  <SolidColorBrush x:Key="SwitchThumbOff" Color="#FF7C8DA3" />
  <SolidColorBrush x:Key="ScrollThumb" Color="#FF2A3B4F" />
  <SolidColorBrush x:Key="HoverSoft" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="PressedSoft" Color="#22FFFFFF" />
  <SolidColorBrush x:Key="WindowBorder" Color="#FF1B2735" />

</ResourceDictionary>