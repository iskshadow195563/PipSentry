<Window x:Class="PipSentry.Views.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PipSentry 監控" Width="520" Height="320" MinWidth="180" MinHeight="110"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        Background="#FF04070A" Foreground="{DynamicResource Text0}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Dark.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid x:Name="Root" Background="#FF04070A" ClipToBounds="True">
    <Rectangle x:Name="VideoSurface" Stretch="Fill">
      <Rectangle.Fill>
        <ImageBrush x:Name="VideoBrush" Stretch="Uniform" />
      </Rectangle.Fill>
    </Rectangle>

    <Border x:Name="FrameBorder" BorderBrush="#6638D0F5" BorderThickness="1" IsHitTestVisible="False" />

    <!-- status -->
    <Border x:Name="StatusOverlay" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="#D90B1119" CornerRadius="10" Padding="14,9" BorderBrush="#33FFFFFF"
            BorderThickness="1" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal">
        <Path x:Name="StatusIcon" Data="{StaticResource IcoPause}" Stroke="{DynamicResource Warn}"
              StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" Text="{DynamicResource Paused}" FontSize="11.5" Foreground="{DynamicResource Text1}"
                   Margin="8,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- hover toolbar -->
    <Border x:Name="Toolbar" VerticalAlignment="Top" Margin="8" Background="#F2070C12"
            CornerRadius="9" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="5" Opacity="0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="22" Height="22" CornerRadius="6" Background="#14FFFFFF" Cursor="SizeAll"
                MouseLeftButtonDown="OnDragHandle" ToolTip="{DynamicResource TooltipDrag}">
          <Path Data="{StaticResource IcoGrip}" Stroke="{DynamicResource Text2}" StrokeThickness="1.2"
                Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <TextBlock x:Name="TitleText" Grid.Column="1" Text="{DynamicResource MonitorTitle}" Margin="8,0" VerticalAlignment="Center"
                   FontSize="11" Foreground="{DynamicResource Text1}" TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap" />

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Border Background="#1F3FD2F5" CornerRadius="5" Padding="6,3" VerticalAlignment="Center"
                  Margin="0,0,6,0" ToolTip="實際更新率">
            <TextBlock x:Name="FpsText" Text="0 FPS" FontSize="9.5" Foreground="{DynamicResource Accent}" />
          </Border>
          <Button x:Name="PauseButton" Style="{StaticResource IconBtnSm}" Tag="{StaticResource IcoPause}"
                  Click="OnTogglePause" ToolTip="{DynamicResource TooltipPause}" />
          <Button Style="{StaticResource IconBtnSm}" Tag="{StaticResource IcoCrop}" Click="OnRedrawRegion"
                  ToolTip="{DynamicResource TooltipRegion}" />
          <Button Style="{StaticResource IconBtnSm}" Tag="{StaticResource IcoCamera}" Click="OnScreenshot"
                  ToolTip="{DynamicResource TooltipShot}" />
          <Button Style="{StaticResource IconBtnSm}" Tag="{StaticResource IcoPin}" Click="OnToggleTopmost"
                  ToolTip="{DynamicResource TooltipTopmost}" />
          <Button Style="{StaticResource IconBtnSm}" Tag="{StaticResource IcoBack}" Click="OnBackToSettings"
                  ToolTip="{DynamicResource TooltipBack}" />
          <Button Style="{StaticResource IconBtnSm}" Tag="{StaticResource IcoClose}" Click="OnCloseMonitor"
                  ToolTip="{DynamicResource TooltipClose}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- stats -->
    <Border x:Name="StatsChip" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
            Background="#B3060A0E" CornerRadius="6" Padding="8,3" IsHitTestVisible="False">
      <TextBlock x:Name="StatsText" Text="" FontSize="9.5" Foreground="{DynamicResource Text2}" />
    </Border>

    <!-- resize grip hint -->
    <Path x:Name="ResizeGrip" Data="M12,0 L12,12 L0,12 Z" Fill="#553FD2F5" Width="12" Height="12"
          Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"
          IsHitTestVisible="False" />

    <!-- click-through badge -->
    <Border x:Name="ThroughBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
            Background="#CC2B1A0E" CornerRadius="6" Padding="8,4" Visibility="Collapsed"
            IsHitTestVisible="False">
      <TextBlock Text="{DynamicResource ThroughBadge}" FontSize="9.5" Foreground="{DynamicResource Warn}" />
    </Border>
  </Grid>
</Window>