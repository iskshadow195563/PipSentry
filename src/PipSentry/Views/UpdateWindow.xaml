<Window x:Class="PipSentry.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UpdateTitle}"
        Width="620" Height="470" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg0}"
        Foreground="{DynamicResource Text0}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Dark.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Background="{DynamicResource Bg0}">
    <Grid Margin="22,18,22,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="{DynamicResource UpdateTitle}" Style="{StaticResource H2}" />
      <TextBlock Grid.Row="1" x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,6,0,10" />

      <Border Grid.Row="2" Background="{DynamicResource Bg1}" CornerRadius="8" Padding="12">
        <ScrollViewer Style="{StaticResource FlatScrollViewer}" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12.5"
                     Foreground="{DynamicResource Text1}" LineHeight="19" />
        </ScrollViewer>
      </Border>

      <StackPanel Grid.Row="3" Margin="0,12,0,0">
        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Visibility="Collapsed" />
        <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Visibility="Collapsed"
                     Margin="0,6,0,0" Background="{DynamicResource Bg2}" Foreground="{DynamicResource Accent}" />
      </StackPanel>

      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button x:Name="SkipButton" Content="{DynamicResource UpdateSkip}" Style="{StaticResource GhostBtn}"
                Height="34" Padding="14,0" Margin="0,0,8,0" Click="OnSkip" />
        <Button x:Name="LaterButton" Content="{DynamicResource UpdateLater}" Style="{StaticResource GhostBtn}"
                Height="34" Padding="14,0" Margin="0,0,8,0" Click="OnLater" />
        <Button x:Name="PageButton" Content="{DynamicResource UpdateOpenPage}" Style="{StaticResource GhostBtn}"
                Height="34" Padding="14,0" Margin="0,0,8,0" Click="OnOpenPage" />
        <Button x:Name="DownloadButton" Content="{DynamicResource UpdateDownload}" Style="{StaticResource PrimaryBtn}"
                Height="34" Padding="16,0" Click="OnDownload" />
      </StackPanel>
    </Grid>
  </Border>
</Window>