<Window x:Class="PipSentry.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}"
        Width="660" Height="620" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg0}"
        Foreground="{DynamicResource Text0}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Dark.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Background="{DynamicResource Bg0}">
    <Grid Margin="22,16,22,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal">
        <Path Data="{StaticResource IcoSettings}" Stroke="{DynamicResource Accent}" StrokeThickness="1.4"
              Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
        <TextBlock Text="{DynamicResource SettingsTitle}" Style="{StaticResource H2}" Margin="10,0,0,0"
                   VerticalAlignment="Center" />
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="CurrentVersionText" Style="{StaticResource Body}" />
          <TextBlock x:Name="CheckStatusText" Style="{StaticResource Caption}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox x:Name="AutoCheckToggle" Style="{StaticResource Switch}" Width="34" Height="20"
                    VerticalAlignment="Center" ToolTip="{DynamicResource SettingsAutoCheck}" />
          <TextBlock Text="{DynamicResource SettingsAutoCheck}" Style="{StaticResource Caption}"
                     VerticalAlignment="Center" Margin="8,0,14,0" />
          <Button x:Name="CheckButton" Content="{DynamicResource SettingsCheckNow}" Style="{StaticResource GhostBtn}"
                  Height="30" Padding="12,0" Click="OnCheck" />
        </StackPanel>
      </Grid>

      <TextBlock Grid.Row="2" Text="{DynamicResource SettingsVersions}" Style="{StaticResource Caption}"
                 Margin="0,16,0,6" />

      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource Bg1}" CornerRadius="8" Padding="4">
          <ListBox x:Name="ReleaseList" Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   SelectionChanged="OnReleaseSelected">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="8,6">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Tag}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text0}" />
                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                            Visibility="{Binding BadgeVisibility}">
                      <TextBlock Text="{Binding Badge}" FontSize="9.5" Foreground="{DynamicResource Accent}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource Bg1}" CornerRadius="8" Padding="12" Margin="10,0,0,0">
          <ScrollViewer Style="{StaticResource FlatScrollViewer}" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12" LineHeight="18"
                       Foreground="{DynamicResource Text1}" />
          </ScrollViewer>
        </Border>
      </Grid>

      <Grid Grid.Row="4" Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock x:Name="DownloadStatusText" Style="{StaticResource Caption}" Visibility="Collapsed" />
          <ProgressBar x:Name="Progress" Height="4" Width="240" Minimum="0" Maximum="100" Visibility="Collapsed"
                       Margin="0,6,0,0" Background="{DynamicResource Bg2}" Foreground="{DynamicResource Accent}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="PageButton" Content="{DynamicResource UpdateOpenPage}" Style="{StaticResource GhostBtn}"
                  Height="34" Padding="14,0" Margin="0,0,8,0" Click="OnOpenPage" />
          <Button x:Name="CloseButton" Content="{DynamicResource HotkeyClose}" Style="{StaticResource GhostBtn}"
                  Height="34" Padding="14,0" Margin="0,0,8,0" Click="OnClose" />
          <Button x:Name="InstallButton" Content="{DynamicResource UpdateDownload}" Style="{StaticResource PrimaryBtn}"
                  Height="34" Padding="16,0" Click="OnInstall" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>